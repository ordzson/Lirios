{
  "name": "lirios",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "config": "node scripts/write-runtime-config.mjs",
    "prestart": "pnpm run config",
    "build": "pnpm run config && ng build",
    "build:vercel": "pnpm run config && ng build --configuration production",
    "typecheck:api": "tsc --project tsconfig.api.json --noEmit",
    "verify:public-build": "bash scripts/verify-public-build.sh",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^26.6.4",
    "@vercel/node": "^20.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
