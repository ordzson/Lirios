# Copy to .env.local for local development (`pnpm run stack:up` first).
# `pnpm exec supabase status -o env` prints the local keys.

# Browser-safe. `pnpm run config` writes these values to public/config.js.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never expose these values in Angular or commit them.
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://media.example.com
