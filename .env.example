# Copy to .env.local for local development (`pnpm run stack:up` first).
# `pnpm exec supabase status -o env` prints the local keys.

# Browser-safe. `pnpm run config` writes these values to public/config.js.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never expose these values in Angular or commit them.
SUPABASE_SERVICE_ROLE_KEY=

# Media storage. Local values point at SeaweedFS from docker-compose.dev.yml
# (development-only keys from docker/seaweedfs/s3.json).
# Production (Cloudflare R2): leave R2_ENDPOINT empty, set R2_ACCOUNT_ID,
# bucket-scoped keys, the bucket name and its public domain.
R2_ENDPOINT=http://127.0.0.1:58333
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=lirios-dev-access
R2_SECRET_ACCESS_KEY=lirios-dev-secret
R2_BUCKET_NAME=lirios-dev
R2_PUBLIC_URL=http://127.0.0.1:58333/lirios-dev
